# Copy to .env for local development. Never commit the real .env file.
SECRET_KEY=change-me-to-a-long-random-string
# Empty = local SQLite in instance/edwom.db. Render sets this automatically.
DATABASE_URL=
# Super admin account, created by `flask --app wsgi setup`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# 1 = load demo shops when the database has no shops
SEED_DEMO=1
# Empty = demo payments. sk_test_... or sk_live_... = real Paystack payments
PAYSTACK_SECRET_KEY=
COMMISSION_RATE=0.08
DELIVERY_SAME_REGION_PESEWAS=2500
DELIVERY_OTHER_REGION_PESEWAS=4500
AUTO_RELEASE_HOURS=72
# Photo limits
MAX_PHOTOS_PER_PRODUCT=8
MAX_PHOTO_MB=10
# Rate-limit storage. memory:// is fine for one instance; use redis://... when you scale out.
RATELIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO
